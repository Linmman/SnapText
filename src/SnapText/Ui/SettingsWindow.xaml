<Window x:Class="SnapText.Ui.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SnapText.Localization"
        Title="{loc:Loc Settings_Title}"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="18">

        <TextBlock Text="{loc:Loc Settings_Language}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ComboBox x:Name="LanguageCombo" Height="26"
                  AutomationProperties.Name="{loc:Loc Settings_Language}">
            <ComboBoxItem Content="{loc:Loc Language_Auto}" />
            <ComboBoxItem Content="{loc:Loc Language_Zh}" />
            <ComboBoxItem Content="{loc:Loc Language_Ja}" />
            <ComboBoxItem Content="{loc:Loc Language_En}" />
        </ComboBox>
        <TextBlock Text="{loc:Loc Settings_LanguageHint}" Foreground="#FF6B6B6B" FontSize="11"
                   Margin="0,4,0,0" TextWrapping="Wrap" />

        <TextBlock Text="{loc:Loc Settings_HotkeysHint}" FontWeight="SemiBold" Margin="0,16,0,8" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc Settings_AdaptiveHint}"
                   Foreground="#FF6B6B6B" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Tray_Grab}" VerticalAlignment="Center" Margin="0,0,0,8" />
            <TextBox x:Name="GrabHotkeyBox" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{loc:Loc A11y_Hotkey_Grab}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Tray_RepeatLast}" VerticalAlignment="Center" Margin="0,0,0,8" />
            <TextBox x:Name="RepeatHotkeyBox" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{loc:Loc A11y_Hotkey_Repeat}" />

        </Grid>

        <TextBlock Text="{loc:Loc Settings_Engine}" FontWeight="SemiBold" Margin="0,16,0,8" />
        <ComboBox x:Name="EngineCombo" Height="26" AutomationProperties.Name="{loc:Loc Settings_Engine}">
            <ComboBoxItem Content="{loc:Loc Engine_Auto}" />
            <ComboBoxItem Content="{loc:Loc Engine_Pp}" />
            <ComboBoxItem Content="{loc:Loc Engine_Windows}" />
        </ComboBox>

        <TextBlock Text="{loc:Loc Settings_LinkOpener}" FontWeight="SemiBold" Margin="0,16,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LinkOpenerBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{loc:Loc Settings_LinkOpener}" />
            <Button Grid.Column="1" Content="{loc:Loc Common_Browse}" Width="72" Height="26" Margin="8,0,0,0"
                    Click="OnBrowseLinkOpenerClick" />
        </Grid>
        <TextBlock Text="{loc:Loc Settings_LinkOpenerHint}"
                   Foreground="#FF6B6B6B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

        <CheckBox x:Name="SilentCopyCheck" Content="{loc:Loc Settings_SilentCopy}" Margin="0,16,0,0"
                  AutomationProperties.Name="{loc:Loc Settings_SilentCopy}" />
        <CheckBox x:Name="MergeLinesCheck" Content="{loc:Loc Settings_MergeLines}" Margin="0,8,0,0"
                  AutomationProperties.Name="{loc:Loc Settings_MergeLines}" />
        <CheckBox x:Name="SaveCaptureCheck" Content="{loc:Loc Settings_SaveCapture}" Margin="0,8,0,0"
                  AutomationProperties.Name="{loc:Loc Settings_SaveCapture}" />
        <CheckBox x:Name="SaveHistoryCheck" Content="{loc:Loc Settings_SaveHistory}"
                  Margin="0,8,0,0" AutomationProperties.Name="{loc:Loc Settings_SaveHistory}" />
        <CheckBox x:Name="AutoStartCheck" Content="{loc:Loc Settings_AutoStart}" Margin="0,8,0,0"
                  AutomationProperties.Name="{loc:Loc Settings_AutoStart}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Loc Common_Save}" Width="96" Height="30" Margin="0,0,8,0" Click="OnSaveClick" IsDefault="True" />
            <Button Content="{loc:Loc Common_Cancel}" Width="80" Height="30" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
