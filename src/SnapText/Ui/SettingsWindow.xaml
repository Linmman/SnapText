<Window x:Class="SnapText.Ui.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapText 设置"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="18">

        <TextBlock Text="快捷键（示例：Ctrl+Alt+Q，支持 A-Z / 0-9 / F1-F12；留空 = 关闭该快捷键）"
                   FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="取字" VerticalAlignment="Center" Margin="0,0,0,8" />
            <TextBox x:Name="GrabHotkeyBox" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     AutomationProperties.Name="取字热键" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="重复上次区域" VerticalAlignment="Center" />
            <TextBox x:Name="RepeatHotkeyBox" Grid.Row="1" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                     AutomationProperties.Name="重复上次区域热键" />
        </Grid>

        <TextBlock Text="识别引擎" FontWeight="SemiBold" Margin="0,16,0,8" />
        <ComboBox x:Name="EngineCombo" Height="26" AutomationProperties.Name="识别引擎">
            <ComboBoxItem Content="自动（优先 PP-OCR 本地，失败回落系统 OCR）" />
            <ComboBoxItem Content="PP-OCRv5 本地（推荐：中文、视频字幕更准）" />
            <ComboBoxItem Content="Windows 系统 OCR（不装模型，纯英文场景快）" />
        </ComboBox>

        <TextBlock Text="打开链接的程序" FontWeight="SemiBold" Margin="0,16,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LinkOpenerBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                     AutomationProperties.Name="打开链接的程序路径" />
            <Button Grid.Column="1" Content="浏览…" Width="72" Height="26" Margin="8,0,0,0"
                    Click="OnBrowseLinkOpenerClick" />
        </Grid>
        <TextBlock Text="留空 = 系统默认浏览器；也可以指定某个 exe（例如另一个浏览器），链接会作为参数传给它。"
                   Foreground="#FF6B6B6B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

        <CheckBox x:Name="SilentCopyCheck" Content="识别后静默复制到剪贴板（不弹出结果窗口）" Margin="0,16,0,0"
                  AutomationProperties.Name="识别后静默复制到剪贴板" />
        <CheckBox x:Name="MergeLinesCheck" Content="多行合并为一整行（适合视频字幕、整句提取）" Margin="0,8,0,0"
                  AutomationProperties.Name="多行合并为一整行" />
        <CheckBox x:Name="SaveCaptureCheck" Content="同时把截图保存为 PNG（图片\SnapText 目录）" Margin="0,8,0,0"
                  AutomationProperties.Name="同时保存截图" />
        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,8,0,0"
                  AutomationProperties.Name="开机自动启动" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="保存" Width="96" Height="30" Margin="0,0,8,0" Click="OnSaveClick" IsDefault="True" />
            <Button Content="取消" Width="80" Height="30" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
