<Window x:Class="SnapText.Ui.ToastWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Opacity="0">
    <Border Background="#E6212121" CornerRadius="10" Padding="14,11"
            MaxWidth="420" BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonUp="OnMouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
            <StackPanel Margin="0,0,16,0">
                <TextBlock x:Name="TitleText" Foreground="#FF8FD3FF" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="BodyText" Foreground="#FFF2F2F2" FontSize="13"
                           TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="96" />
                <Border x:Name="ActionArea" Visibility="Collapsed" Margin="0,9,0,0"
                        HorizontalAlignment="Left" Background="#3300A8FF" CornerRadius="6"
                        Padding="11,5" Cursor="Hand"
                        MouseLeftButtonUp="OnActionClick">
                    <TextBlock x:Name="ActionText" Foreground="#FF9FE0FF" FontSize="12" />
                </Border>
            </StackPanel>

            <!-- 关闭按钮：提示可能挡住屏幕上的东西，随时可点掉（文案由代码按界面语言设置） -->
            <Border x:Name="CloseArea" Width="18" Height="18"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0"
                    CornerRadius="4" Cursor="Hand"
                    MouseLeftButtonUp="OnCloseButtonClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="✕" Foreground="#99FFFFFF" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
