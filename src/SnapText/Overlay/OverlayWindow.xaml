<Window x:Class="SnapText.Overlay.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual">
    <Grid x:Name="RootGrid">
        <Image x:Name="FrozenImage" Stretch="Fill" IsHitTestVisible="False" />
        <Rectangle x:Name="DimRect" Fill="#66000000" IsHitTestVisible="False" />
        <Image x:Name="SelectionImage" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" />
        <Rectangle x:Name="SelectionBorder" Visibility="Collapsed" IsHitTestVisible="False"
                   Stroke="#FF00A8FF" StrokeThickness="1.5"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Canvas x:Name="GuideCanvas" IsHitTestVisible="False">
            <Line x:Name="GuideH" Stroke="#99FFFFFF" StrokeThickness="1" Visibility="Collapsed" />
            <Line x:Name="GuideV" Stroke="#99FFFFFF" StrokeThickness="1" Visibility="Collapsed" />
        </Canvas>
        <Border x:Name="SizeLabel" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#D9000000" CornerRadius="3" Padding="7,3"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Consolas" />
        </Border>
        <Border x:Name="HintLabel" IsHitTestVisible="False"
                Background="#B2000000" CornerRadius="4" Padding="12,6"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <TextBlock Foreground="White" FontSize="13"
                       Text="框选要识别的文字 · 松开鼠标即复制到剪贴板 · Esc 取消" />
        </Border>
    </Grid>
</Window>
